<script>


// ===============================
// KONFETTI GENERATOR
// ===============================


function createConfetti(){


const colors=[

"#ffd700",
"#ffffff",
"#00ff7f",
"#ff5252",
"#4dabff"

];



for(let i=0;i<120;i++){


let piece =
document.createElement("div");



piece.className="confetti";



piece.style.left =
Math.random()*100+"vw";



piece.style.background =
colors[
Math.floor(
Math.random()*colors.length
)
];



piece.style.animationDuration =
(3+
Math.random()*5)
+"s";



piece.style.animationDelay =
Math.random()*3+"s";



piece.style.transform =
"rotate("+
Math.random()*360+
"deg)";



document.body.appendChild(piece);




setTimeout(()=>{

piece.remove();

},9000);



}



}



// Konfetti nach Laden starten

setTimeout(
createConfetti,
1000
);





// ===============================
// AUTOMATISCHES UPDATE
// ===============================
//
// Alle 30 Sekunden neu laden
//


setInterval(

loadRanking,

30000

);



</script>

