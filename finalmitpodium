<script>


// ===============================
// SUPABASE KONFIGURATION
// ===============================


const supabaseUrl =
"https://kmhwwdsuzphkpfupkynf.supabase.co";


const supabaseKey =
"sb_publishable_7ih4VSPUkXVfHkBa7lrDCA_mO_d0pW1";


const supabaseClient =
supabase.createClient(
    supabaseUrl,
    supabaseKey
);



// ===============================
// BILDER
// ===============================
//
// Die Datenbank liefert nur den Dateinamen.
// Die Bilder liegen lokal im Ordner "bilder".
//
// Beispiel:
// bild = "max.png"
// Ergebnis:
// bilder/max.png
//


function getImage(filename){

    if(!filename || filename.trim()===""){
        return "bilder/default.png";
    }

    return "bilder/" + filename;

}



// ===============================
// DATEN LADEN
// ===============================


async function loadRanking(){


    const {data,error} =
    await supabaseClient
    .from("rangliste")
    .select("*")
    .order("rang",{ascending:true});


    if(error){

        console.error(
            "Fehler beim Laden:",
            error
        );

        return;

    }


    createPodium(data.slice(0,3));

    createTop10(data.slice(0,10));


}



// ===============================
// SIEGERPODEST
// ===============================


function createPodium(players){


    const podium =
    document.getElementById("podium");


    podium.innerHTML="";


    /*
       Reihenfolge:
       Platz 2
       Platz 1
       Platz 3

       damit Platz 1 in der Mitte steht
    */


    const order=[

        players[1],
        players[0],
        players[2]

    ];



    order.forEach((player,index)=>{


        if(!player)
            return;



        let place =
        player.rang;



        let cssClass="";


        if(place===1)
            cssClass="first";

        if(place===2)
            cssClass="second";

        if(place===3)
            cssClass="third";



        const div =
        document.createElement("div");


        div.className =
        "player "+cssClass;



        div.innerHTML=`

            <div class="avatar">

                <img 
                src="${getImage(player.bild)}"
                onerror="
                this.src='bilder/default.png'
                "
                >

            </div>


            <div class="username">
                ${player.username}
            </div>


            <div class="block">

                ${place}

            </div>

        `;



        podium.appendChild(div);



    });



}



// ===============================
// TOP 10 LISTE
// ===============================


function createTop10(players){


    const list =
    document.getElementById("top10");


    list.innerHTML="";



    players.forEach(
    (player,index)=>{


        const row =
        document.createElement("div");


        row.className="row";


        row.style.animationDelay =
        (index*0.08)+"s";



        row.innerHTML=`

            <div class="rankNumber">
                ${player.rang}
            </div>


            <img 
            src="${getImage(player.bild)}"
            onerror="
            this.src='bilder/default.png'
            "
            >


            <div class="nameBox">

                ${player.username}

            </div>


        `;



        list.appendChild(row);



    });


}



// ===============================
// START
// ===============================


loadRanking();



</script>

