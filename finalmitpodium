<script>


// ===============================
// FEHLERANZEIGE
// ===============================


function showError(message){


const box =
document.createElement("div");


box.style.position="fixed";

box.style.top="20px";

box.style.left="50%";

box.style.transform=
"translateX(-50%)";


box.style.background=
"rgba(255,0,0,.85)";


box.style.padding=
"15px 25px";


box.style.borderRadius=
"15px";


box.style.fontWeight=
"bold";


box.style.zIndex="9999";


box.innerHTML=
"⚠️ "+message;


document.body.appendChild(box);



setTimeout(()=>{

box.remove();

},5000);



}





// ===============================
// SUPABASE LIVE CHANNEL
// ===============================
//
// Aktualisiert die Seite,
// sobald sich die Rangliste ändert
//


const rankingChannel =
supabaseClient
.channel("rangliste-live")
.on(

"postgres_changes",

{

event:"*",

schema:"public",

table:"rangliste"

},

(payload)=>{


console.log(
"Rangliste geändert",
payload
);


loadRanking();


}

)
.subscribe();






// ===============================
// BESSERER BILDER-FALLBACK
// ===============================


function safeImage(element){


element.onerror=function(){


this.onerror=null;


this.src=
"bilder/default.png";


};


}






// ===============================
// START NACH DATENBANK CHECK
// ===============================


async function checkDatabase(){


const {data,error}=

await supabaseClient
.from("rangliste")
.select("username")
.limit(1);



if(error){

showError(
"Verbindung zur Rangliste fehlgeschlagen"
);

console.error(error);


}


}



checkDatabase();





// ===============================
// EINFÜGE-EFFEKT FÜR NEUE SPIELER
// ===============================


let previousRanking=[];



async function animatedRefresh(){


const {data,error}=

await supabaseClient
.from("rangliste")
.select("*")
.order(
"rang",
{
ascending:true
}
);



if(error)
return;



let changed =
JSON.stringify(data)
!==
JSON.stringify(previousRanking);



if(changed){


previousRanking=data;


createPodium(
data.slice(0,3)
);


createTop10(
data.slice(0,10)
);


createConfetti();


}



}



setInterval(

animatedRefresh,

10000

);



</script>

