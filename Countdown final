<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title> Countdown</title>

  <style>
    body {
  margin: 0;
  height: 100vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;   /* statt center */

  padding-top: 50px;             /* Abstand nach oben */

  background-image: url("rasen chatgpt.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

    #header {
  display: flex;
  justify-content: center;
}

    #logo-container {
      position: relative;
      display: inline-block;
    }

    #logo {
      width: 510px;
      height: auto;
    }

    #ball-wrapper {
      position: absolute;
      left: 15.2%;
      top: 56%;
      transform: translate(-50%, -50%);
      animation: flug 1.5s ease-out forwards;
    }

    #ball {
      width: 26px;
      height: 26px;
      animation: spin 15s linear infinite;
    }

    #container {
  width: 450px;
  margin-top: 10px;
  padding: 30px;
  background: transparent;
}

    #container h2,
    #container p,
    #container a {
      color: white;
    }

    input {
  width: 100%;
  padding: 16px;
  border-radius: 8px;
  border: none;
  font-size: 20px;
  box-sizing: border-box;
}

    button {
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes flug {
      from {
        transform:
          translate(-50%, -50%)
          translate(430px, 400px);
      }

      to {
        transform:
          translate(-50%, -50%)
          translate(0, 0);
      }
    }
  </style>
</head>

<body>

  <div id="header">
    <div id="logo-container">
      <img id="logo" src="logo mit titel final.png" alt="WiG Tippspiel">

      <span id="ball-wrapper">
        <img id="ball" src="fussball_ohne_schatten.png" alt="Ball">
      </span>
    </div>
  </div>

</body>
</html>
