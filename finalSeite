<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Final</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      display: flex;
      justify-content: flex-start;
      align-items: center;
      flex-direction: column;

      padding: 50px 12px 40px;

      font-family: Arial, sans-serif;
      text-align: center;

      background-image: url("rasen chatgpt.png");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;

      overflow-x: hidden;
      overflow-y: auto;
    }

    #finalseite {
      width: min(980px, 100%);
      margin: 0 auto;
    }

    /* =====================================================
       URSPRÜNGLICHES LOGO, SONNE UND BALL
       ===================================================== */

    #logo-container {
      position: relative;
      display: inline-block;
      margin-bottom: 18px;
    }

    #logo {
      position: relative;
      z-index: 2;

      width: 510px;
      max-width: 92vw;
      height: auto;

      display: block;
    }

    #ball-wrapper {
      position: absolute;

      left: 13.3%;
      top: 39%;

      transform: translate(-50%, -50%);

      animation: flug 1.5s ease-out forwards;

      z-index: 10;
    }

    #ball {
      width: 24px;
      height: 24px;

      display: block;

      animation: spin 15s linear infinite;
    }

    #sonne {
      position: absolute;

      right: 1px;
      top: 6px;

      width: 65px;
      height: 45px;

      transform-origin: center;

      animation: drehen 20s linear infinite;

      z-index: 0;
    }

    .strahl {
      position: absolute;

      left: 50%;
      top: 50%;

      width: 6px;
      height: 55px;

      background: linear-gradient(
        to top,
        rgba(255, 210, 0, 0),
        rgba(255, 230, 90, 0.9)
      );

      border-radius: 10px;

      transform:
        translate(-50%, -100%)
        rotate(calc(var(--i) * 30deg));

      transform-origin: center bottom;

      filter: blur(1px);
    }

    @keyframes drehen {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    @keyframes spin {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    @keyframes flug {
      from {
        transform:
          translate(-50%, -50%)
          translate(430px, 400px)
          scale(4);
      }

      to {
        transform:
          translate(-50%, -50%)
          translate(0, 0)
          scale(1);
      }
    }

    /* =====================================================
       ÜBERSCHRIFT UND KLEINE SUCHLEISTE
       ===================================================== */

    #ranglisten-titel {
      margin: 0 0 10px;

      color: white;

      font-size: clamp(23px, 4vw, 34px);
      font-weight: 900;

      text-shadow:
        2px 2px 6px rgba(0, 0, 0, 0.75);
    }

    #suche-wrapper {
      display: flex;
      justify-content: flex-end;

      margin: 0 0 8px;
    }

    #suche {
      width: 230px;
      max-width: 58vw;
      height: 36px;

      padding: 6px 10px;

      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: 7px;

      outline: none;

      font-size: 14px;
      font-weight: bold;

      box-shadow:
        0 3px 9px rgba(0, 0, 0, 0.18);
    }

    #suche:focus {
      border-color: #0066cc;
    }

    #ausgabe {
      min-height: 20px;

      margin-bottom: 6px;

      color: white;

      font-size: 14px;
      font-weight: bold;

      text-shadow:
        1px 1px 4px rgba(0, 0, 0, 0.8);
    }

    /* =====================================================
       RANGLISTE
       ===================================================== */

    .table-shell {
      width: 100%;

      /*
       * Wichtig:
       * keine horizontale Scrollfläche.
       */
      overflow: visible;

      background: white;

      border-radius: 12px;

      box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.3);
    }

    .rangliste-table {
      width: 100%;

      border-collapse: collapse;
      table-layout: fixed;
    }

    /*
     * Prozentuale Spaltenbreiten.
     * Dadurch bleibt die gesamte Tabelle innerhalb
     * der Bildschirmbreite.
     */

    .col-platz {
      width: 11%;
    }

    .col-user {
      width: 21%;
    }

    .col-punkte {
      width: 13%;
    }

    .col-spiel {
      width: 27.5%;
    }

    .col-zusatz {
      width: 27.5%;
    }

    th,
    td {
      height: 60px;

      padding: 8px 5px;

      border: 1px solid #d2d2d2;

      background: white;

      text-align: center;
      vertical-align: middle;

      font-size: clamp(13px, 2vw, 18px);
      font-weight: bold;
      line-height: 1.15;

      overflow-wrap: anywhere;
      word-break: break-word;
    }

    thead th {
      height: 80px;

      background: #ececec;

      font-size: clamp(12px, 1.8vw, 16px);
    }

    tbody tr:hover td {
      background: #f4f8ff;
    }

    /*
     * Die Gewinner werden stärker hervorgehoben.
     */

    .platz-1 td {
      background: #fff4b8;
      font-weight: 900;
    }

    .platz-2 td {
      background: #f1f1f1;
    }

    .platz-3 td {
      background: #f5dfcf;
    }

    /*
     * Der eingeloggte Spieler erhält nur einen blauen Rahmen.
     * Dadurch wird die Gewinnerfarbe nicht überschrieben.
     */

    .eigene-zeile td {
      outline: 2px solid #0066cc;
      outline-offset: -2px;
    }

    /* =====================================================
       PFEILE IN DEN BEIDEN TIPP-SPALTEN
       ===================================================== */

    .navigation-kopf {
      display: grid;

      grid-template-columns:
        30px
        minmax(0, 1fr)
        30px;

      align-items: center;

      gap: 4px;
    }

    .nav-button {
      width: 30px;
      height: 32px;

      padding: 0;

      border: none;
      border-radius: 6px;

      background: #e60000;
      color: white;

      font-size: 17px;
      font-weight: bold;

      cursor: pointer;
    }

    .nav-button:hover {
      background: #b90000;
    }

    .kopf-titel,
    .kopf-ergebnis {
      display: block;

      overflow-wrap: anywhere;

      line-height: 1.1;
    }

    .kopf-titel {
      font-size: inherit;
    }

    .kopf-ergebnis {
      margin-top: 4px;

      color: #555;

      font-size: 0.86em;
    }

    .tipp-punkte {
      margin-left: 3px;

      color: #e60000;

      font-size: 0.72em;

      vertical-align: super;
    }

    .tipp-punkte.offen {
      color: #666;

      font-size: 0.65em;
    }

    .keine-treffer td {
      height: 70px;

      color: #555;
    }

    /* =====================================================
       HANDY
       ===================================================== */

    @media (max-width: 600px) {

      body {
        padding: 22px 5px 30px;

        background-attachment: scroll;
      }

      #logo-container {
        margin-bottom: 12px;
      }

      #logo {
        max-width: 94vw;
      }

      #ranglisten-titel {
        margin-bottom: 7px;

        font-size: 23px;
      }

      #suche-wrapper {
        justify-content: center;

        margin-bottom: 6px;
      }

      #suche {
        width: 175px;
        max-width: 70vw;
        height: 32px;

        font-size: 12px;
      }

      .table-shell {
        border-radius: 8px;
      }

      th,
      td {
        height: 52px;

        padding: 5px 2px;

        font-size: 11px;
      }

      thead th {
        height: 72px;

        font-size: 10px;
      }

      .navigation-kopf {
        grid-template-columns:
          22px
          minmax(0, 1fr)
          22px;

        gap: 2px;
      }

      .nav-button {
        width: 22px;
        height: 27px;

        border-radius: 5px;

        font-size: 13px;
      }

      .kopf-ergebnis {
        margin-top: 3px;

        font-size: 9px;
      }

      .tipp-punkte {
        margin-left: 1px;
      }
    }

    /*
     * Sehr schmale Handys.
     */

    @media (max-width: 390px) {

      .col-platz {
        width: 10%;
      }

      .col-user {
        width: 20%;
      }

      .col-punkte {
        width: 12%;
      }

      .col-spiel {
        width: 29%;
      }

      .col-zusatz {
        width: 29%;
      }

      th,
      td {
        padding: 4px 1px;

        font-size: 10px;
      }

      thead th {
        font-size: 9px;
      }

      .navigation-kopf {
        grid-template-columns:
          19px
          minmax(0, 1fr)
          19px;
      }

      .nav-button {
        width: 19px;
        height: 25px;

        font-size: 12px;
      }
    }
  </style>
</head>

