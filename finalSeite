  <script type="module">

    /* =====================================================
       SUPABASE
       ===================================================== */

    import {
      createClient
    } from "https://esm.sh/@supabase/supabase-js@2";


    const supabase =
      createClient(

        "https://kmhwwdsuzphkpfupkynf.supabase.co",

        "sb_publishable_7ih4VSPUkXVfHkBa7lrDCA_mO_d0pW1"

      );


    /* =====================================================
       SPÄTER HIER DIE ECHTEN ERGEBNISSE EINTRAGEN

       Leere Werte bedeuten:
       Das Ergebnis steht noch nicht fest und es werden
       dafür noch keine Zusatzpunkte verteilt.
       ===================================================== */

    const OFFIZIELLE_ERGEBNISSE = {

      weltmeister: "",

      vizeweltmeister: "",

      besterspieler: ""

    };


    /* =====================================================
       PUNKTE
       ===================================================== */

    const PUNKTE = {

      exakt: 4,

      differenz: 3,

      sieger: 2,

      unentschieden: 2,

      zusatz: 3

    };


    const ZUSATZ_KATEGORIEN = [

      {
        key: "weltmeister",
        titel: "Weltmeister"
      },

      {
        key: "vizeweltmeister",
        titel: "Vizeweltmeister"
      },

      {
        key: "besterspieler",
        titel: "Bester Spieler"
      }

    ];


    /* =====================================================
       VARIABLEN
       ===================================================== */

    let currentUserId = null;

    let spiele = [];

    let users = [];

    let tipps = [];

    let zusatztipps = [];

    let rangliste = [];

    let spielIndex = 0;

    let zusatzIndex = 0;


    /* =====================================================
       DATEN LADEN
       ===================================================== */

    async function ladeAlle(
      tabelle,
      spalten = "*",
      sortierung = null
    ) {

      let ergebnis = [];

      let start = 0;


      while (true) {

        let query = supabase

          .from(tabelle)

          .select(spalten)

          .range(
            start,
            start + 999
          );


        if (sortierung) {

          query = query.order(

            sortierung,

            {
              ascending: true
            }

          );

        }


        const {
          data,
          error
        } = await query;


        if (error) {

          throw new Error(

            `${tabelle}: ${error.message}`

          );

        }


        ergebnis.push(

          ...(data || [])

        );


        if (
          !data ||
          data.length < 1000
        ) {

          break;

        }


        start += 1000;

      }


      return ergebnis;

    }


    async function datenLaden() {

      [
        spiele,
        users,
        tipps,
        zusatztipps
      ] = await Promise.all([

        ladeAlle(
          "spiele",
          "*",
          "id"
        ),

        ladeAlle(
          "users_public",
          "user_ID,username,avatar"
        ),

        ladeAlle(
          "tipps"
        ),

        ladeAlle(
          "zusatztipps"
        )

      ]);

    }


    async function userErmitteln() {

      const {
        data
      } = await supabase.auth.getSession();


      currentUserId =
        data?.session?.user?.id || null;

    }


    /* =====================================================
       TEXTE VERGLEICHEN
       ===================================================== */

    function normalisieren(text) {

      return String(text || "")

        .normalize("NFD")

        .replace(
          /[\u0300-\u036f]/g,
          ""
        )

        .replace(
          /ß/g,
          "ss"
        )

        .toLowerCase()

        .replace(
          /[^a-z0-9 ]/g,
          " "
        )

        .replace(
          /\s+/g,
          " "
        )

        .trim();

    }


    /*
     * Berechnet kleine Unterschiede zwischen Namen.
     */

    function abstand(a, b) {

      const zeile = Array.from(

        {
          length: b.length + 1
        },

        (_, i) => i

      );


      for (
        let i = 1;
        i <= a.length;
        i++
      ) {

        let vorher =
          zeile[0];


        zeile[0] = i;


        for (
          let j = 1;
          j <= b.length;
          j++
        ) {

          const alt =
            zeile[j];


          zeile[j] = Math.min(

            zeile[j] + 1,

            zeile[j - 1] + 1,

            vorher
            +
            (
              a[i - 1] === b[j - 1]
                ? 0
                : 1
            )

          );


          vorher = alt;

        }

      }


      return zeile[b.length];

    }


    /*
     * Beispiele, die als gleich gelten:
     *
     * Mbappé
     * Mbappe
     * Kylian Mbappé
     * Kylian Mbape
     */

    function spielernameStimmt(
      tipp,
      ergebnis
    ) {

      const a =
        normalisieren(tipp);


      const b =
        normalisieren(ergebnis);


      if (
        !a ||
        !b
      ) {

        return false;

      }


      const kompaktA =
        a.replaceAll(
          " ",
          ""
        );


      const kompaktB =
        b.replaceAll(
          " ",
          ""
        );


      if (
        kompaktA === kompaktB
      ) {

        return true;

      }


      if (

        Math.min(
          kompaktA.length,
          kompaktB.length
        ) >= 5

        &&

        (
          kompaktA.includes(
            kompaktB
          )

          ||

          kompaktB.includes(
            kompaktA
          )
        )

      ) {

        return true;

      }


      const woerterA =
        a
          .split(" ")
          .filter(
            wort =>
              wort.length >= 4
          );


      const woerterB =
        b
          .split(" ")
          .filter(
            wort =>
              wort.length >= 4
          );


      return woerterA.some(

        wortA =>

          woerterB.some(

            wortB => {

              const erlaubteFehler =

                Math.max(
                  wortA.length,
                  wortB.length
                ) >= 8

                  ? 2

                  : 1;


              return abstand(
                wortA,
                wortB
              ) <= erlaubteFehler;

            }

          )

      );

    }


    /* =====================================================
       SPIELPUNKTE
       ===================================================== */

    function holeSpiel(spielId) {

      return spiele.find(

        spiel =>
          String(spiel.id)
          ===
          String(spielId)

      );

    }


    function spielIstFertig(spiel) {

      return Boolean(

        spiel?.["Spiel_fertig?"]

      );

    }


    function spielpunkte(
      spielId,
      tippA,
      tippB
    ) {

      const spiel =
        holeSpiel(spielId);


      if (
        !spielIstFertig(spiel)
      ) {

        return 0;

      }


      if (
        spiel.tore_team_a == null
        ||
        spiel.tore_team_b == null
      ) {

        return 0;

      }


      const a =
        Number(tippA);


      const b =
        Number(tippB);


      const echtA =
        Number(
          spiel.tore_team_a
        );


      const echtB =
        Number(
          spiel.tore_team_b
        );


      if (

        ![
          a,
          b,
          echtA,
          echtB
        ].every(
          Number.isFinite
        )

      ) {

        return 0;

      }


      const echteDifferenz =
        echtA - echtB;


      const tippDifferenz =
        a - b;


      if (
        a === echtA
        &&
        b === echtB
      ) {

        return PUNKTE.exakt;

      }


      if (

        echteDifferenz === tippDifferenz

        &&

        echteDifferenz !== 0

      ) {

        return PUNKTE.differenz;

      }


      if (

        echteDifferenz === 0

        &&

        tippDifferenz === 0

      ) {

        return PUNKTE.unentschieden;

      }


      if (

        Math.sign(
          echteDifferenz
        )

        ===

        Math.sign(
          tippDifferenz
        )

      ) {

        return PUNKTE.sieger;

      }


      return 0;

    }


    /* =====================================================
       ZUSATZTIPPS
       ===================================================== */

    function zusatzDatensatz(userId) {

      return zusatztipps.find(

        tipp =>
          String(tipp.user_ID)
          ===
          String(userId)

      );

    }


    function zusatzWert(
      userId,
      kategorie
    ) {

      const tipp =
        zusatzDatensatz(userId);


      if (!tipp) {

        return "";

      }


      if (
        kategorie === "weltmeister"
      ) {

        return (
          tipp.weltmeister
          ||
          ""
        );

      }


      if (
        kategorie === "besterspieler"
      ) {

        return (

          tipp.besterspieler

          ||

          tipp.bester_spieler

          ||

          ""

        );

      }


      /*
       * Eure Spalte kann viezeweltmeister heißen.
       * Die anderen Schreibweisen werden ebenfalls unterstützt.
       */

      return (

        tipp.vizeweltmeister

        ||

        tipp.viezeweltmeister

        ||

        tipp.vize_weltmeister

        ||

        ""

      );

    }


    function zusatzpunkte(
      userId,
      kategorie
    ) {

      const tipp =
        zusatzWert(
          userId,
          kategorie
        );


      const ergebnis =
        OFFIZIELLE_ERGEBNISSE[
          kategorie
        ];


      if (
        !normalisieren(ergebnis)
      ) {

        return 0;

      }


      const stimmt =

        kategorie === "besterspieler"

          ? spielernameStimmt(
              tipp,
              ergebnis
            )

          : normalisieren(tipp)
            ===
            normalisieren(ergebnis);


      return stimmt
        ? PUNKTE.zusatz
        : 0;

    }


    /* =====================================================
       GESAMTPUNKTE UND RANGLISTE
       ===================================================== */

    function gesamtpunkte(userId) {

      const punkteAusSpielen = tipps

        .filter(

          tipp =>
            String(tipp.tipper_ID)
            ===
            String(userId)

        )

        .reduce(

          (
            summe,
            tipp
          ) =>

            summe

            +

            spielpunkte(

              tipp.spiel_ID,

              tipp.tore_team_a,

              tipp.tore_team_b

            ),

          0

        );


      const punkteAusZusatz =
        ZUSATZ_KATEGORIEN.reduce(

          (
            summe,
            kategorie
          ) =>

            summe

            +

            zusatzpunkte(

              userId,

              kategorie.key

            ),

          0

        );


      return (
        punkteAusSpielen
        +
        punkteAusZusatz
      );

    }


    function ranglisteBerechnen() {

      rangliste = users.map(

        user => ({

          user_ID:
            user.user_ID,

          username:
            user.username
            ||
            "Unbekannt",

          punkte:
            gesamtpunkte(
              user.user_ID
            )

        })

      );


      rangliste.sort(

        (
          a,
          b
        ) =>

          b.punkte
          -
          a.punkte

          ||

          a.username.localeCompare(
            b.username,
            "de"
          )

      );


      let rang = 1;

      let letztePunkte = null;


      rangliste.forEach(

        (
          eintrag,
          index
        ) => {

          if (

            letztePunkte !== null

            &&

            eintrag.punkte
            <
            letztePunkte

          ) {

            rang =
              index + 1;

          }


          eintrag.rang =
            rang;


          letztePunkte =
            eintrag.punkte;

        }

      );

    }


    function formatPlatz(rang) {

      if (
        rang === 1
      ) {

        return "🥇 1";

      }


      if (
        rang === 2
      ) {

        return "🥈 2";

      }


      if (
        rang === 3
      ) {

        return "🥉 3";

      }


      return String(rang);

    }


    /* =====================================================
       SPIEL- UND ZUSATZTIPP-NAVIGATION
       ===================================================== */

    function startspielSetzen() {

      const letzterFertigerIndex =
        spiele.reduce(

          (
            letzter,
            spiel,
            index
          ) =>

            spielIstFertig(spiel)

              ? index

              : letzter,

          -1

        );


      spielIndex =

        letzterFertigerIndex >= 0

          ? letzterFertigerIndex

          : 0;

    }


    function spielWechseln(richtung) {

      if (
        !spiele.length
      ) {

        return;

      }


      spielIndex = (

        spielIndex

        +

        richtung

        +

        spiele.length

      ) % spiele.length;


      tabelleRendern();

    }


    function zusatzWechseln(richtung) {

      zusatzIndex = (

        zusatzIndex

        +

        richtung

        +

        ZUSATZ_KATEGORIEN.length

      ) % ZUSATZ_KATEGORIEN.length;


      tabelleRendern();

    }


    /* =====================================================
       TABELLENKOPF
       ===================================================== */

    function kopfAktualisieren() {

      const spiel =
        spiele[spielIndex];


      const kategorie =
        ZUSATZ_KATEGORIEN[
          zusatzIndex
        ];


      const zusatzErgebnis =
        OFFIZIELLE_ERGEBNISSE[
          kategorie.key
        ];


      document
        .getElementById(
          "spielTitel"
        )
        .textContent = spiel

          ? (
              spiel.name

              ||

              `${spiel.team_a || "?"} - ${spiel.team_b || "?"}`
            )

          : "Keine Spiele";


      document
        .getElementById(
          "spielErgebnis"
        )
        .textContent = spielIstFertig(spiel)

          ? `${spiel.tore_team_a} : ${spiel.tore_team_b}`

          : "Ergebnis offen";


      document
        .getElementById(
          "zusatzTitel"
        )
        .textContent =
          kategorie.titel;


      document
        .getElementById(
          "zusatzErgebnis"
        )
        .textContent =
          normalisieren(
            zusatzErgebnis
          )

            ? `Ergebnis: ${zusatzErgebnis}`

            : "Ergebnis offen";

    }


    /* =====================================================
       TABELLENZELLEN
       ===================================================== */

    function wertMitPunkten(
      zelle,
      wert,
      punkte,
      offen = false
    ) {

      zelle.textContent =
        wert || "–";


      const hochgestellt =
        document.createElement(
          "sup"
        );


      hochgestellt.className =
        `tipp-punkte${offen ? " offen" : ""}`;


      hochgestellt.textContent =
        offen
          ? "offen"
          : punkte;


      zelle.appendChild(
        hochgestellt
      );

    }


    function spielTipp(userId) {

      const spiel =
        spiele[spielIndex];


      if (
        !spielIstFertig(spiel)
      ) {

        return {

          wert: "– : –",

          punkte: 0,

          offen: true

        };

      }


      const tipp = tipps.find(

        eintrag =>

          String(eintrag.tipper_ID)
          ===
          String(userId)

          &&

          String(eintrag.spiel_ID)
          ===
          String(spiel.id)

      );


      if (!tipp) {

        return {

          wert: "– : –",

          punkte: 0,

          offen: false

        };

      }


      return {

        wert:
          `${tipp.tore_team_a} : ${tipp.tore_team_b}`,

        punkte:
          spielpunkte(

            spiel.id,

            tipp.tore_team_a,

            tipp.tore_team_b

          ),

        offen:
          false

      };

    }


    function zusatzTipp(userId) {

      const kategorie =
        ZUSATZ_KATEGORIEN[
          zusatzIndex
        ];


      const ergebnisIstOffen =
        !normalisieren(

          OFFIZIELLE_ERGEBNISSE[
            kategorie.key
          ]

        );


      return {

        wert:
          zusatzWert(

            userId,

            kategorie.key

          ) || "–",

        punkte:
          ergebnisIstOffen

            ? 0

            : zusatzpunkte(

                userId,

                kategorie.key

              ),

        offen:
          ergebnisIstOffen

      };

    }


    /* =====================================================
       ZEILE ANZEIGEN
       ===================================================== */

    function zeileRendern(
      tbody,
      eintrag
    ) {

      const zeile =
        tbody.insertRow();


      /*
       * Top 3 besonders hervorheben.
       */

      if (
        eintrag.rang <= 3
      ) {

        zeile.classList.add(

          `platz-${eintrag.rang}`

        );

      }


      /*
       * Eingeloggten Benutzer zusätzlich umrahmen.
       */

      if (

        String(eintrag.user_ID)

        ===

        String(currentUserId)

      ) {

        zeile.classList.add(
          "eigene-zeile"
        );

      }


      zeile
        .insertCell()
        .textContent =
          formatPlatz(
            eintrag.rang
          );


      zeile
        .insertCell()
        .textContent =
          eintrag.username;


      zeile
        .insertCell()
        .textContent =
          eintrag.punkte;


      const spielDaten =
        spielTipp(
          eintrag.user_ID
        );


      wertMitPunkten(

        zeile.insertCell(),

        spielDaten.wert,

        spielDaten.punkte,

        spielDaten.offen

      );


      const zusatzDaten =
        zusatzTipp(
          eintrag.user_ID
        );


      wertMitPunkten(

        zeile.insertCell(),

        zusatzDaten.wert,

        zusatzDaten.punkte,

        zusatzDaten.offen

      );

    }


    /* =====================================================
       TOP 5 ODER SUCHERGEBNISSE
       ===================================================== */

    function sichtbareSpieler() {

      const suche =
        normalisieren(

          document
            .getElementById(
              "suche"
            )
            .value

        );


      /*
       * Ohne Suche:
       * Nur die fünf besten Spieler.
       */

      if (!suche) {

        return rangliste.slice(
          0,
          5
        );

      }


      /*
       * Mit Suche:
       * Alle passenden Spieler.
       */

      return rangliste.filter(

        eintrag =>

          normalisieren(
            eintrag.username
          ).includes(
            suche
          )

      );

    }


    /* =====================================================
       TABELLE RENDERN
       ===================================================== */

    function tabelleRendern() {

      kopfAktualisieren();


      const tbody =
        document.getElementById(
          "ranglisteBody"
        );


      const eintraege =
        sichtbareSpieler();


      tbody.innerHTML = "";


      if (
        !eintraege.length
      ) {

        const zeile =
          tbody.insertRow();


        zeile.className =
          "keine-treffer";


        const zelle =
          zeile.insertCell();


        zelle.colSpan = 5;


        zelle.textContent =
          "Kein Spieler gefunden.";


        return;

      }


      eintraege.forEach(

        eintrag =>

          zeileRendern(

            tbody,

            eintrag

          )

      );

    }


    /* =====================================================
       SEITE STARTEN
       ===================================================== */

    async function initialisieren() {

      const ausgabe =
        document.getElementById(
          "ausgabe"
        );


      ausgabe.textContent =
        "Rangliste wird geladen …";


      try {

        await userErmitteln();

        await datenLaden();

        startspielSetzen();

        ranglisteBerechnen();

        tabelleRendern();


        ausgabe.textContent = "";

      } catch (error) {

        console.error(error);


        ausgabe.textContent =
          `Fehler beim Laden: ${error.message}`;

      }

    }


    /* =====================================================
       BUTTONS UND SUCHFELD
       ===================================================== */

    document
      .getElementById(
        "suche"
      )
      .addEventListener(
        "input",
        tabelleRendern
      );


    document
      .getElementById(
        "spielZurueck"
      )
      .addEventListener(
        "click",
        () => spielWechseln(-1)
      );


    document
      .getElementById(
        "spielWeiter"
      )
      .addEventListener(
        "click",
        () => spielWechseln(1)
      );


    document
      .getElementById(
        "zusatzZurueck"
      )
      .addEventListener(
        "click",
        () => zusatzWechseln(-1)
      );


    document
      .getElementById(
        "zusatzWeiter"
      )
      .addEventListener(
        "click",
        () => zusatzWechseln(1)
      );


    initialisieren();

  </script>

